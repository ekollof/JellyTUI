/* JellyTUI styles */

Screen {
    background: $background;
    color: $foreground;
}

Header {
    background: $panel;
    color: $foreground;
}

Footer {
    background: $panel;
}

/* --------------------------------------------------------------- login */

LoginScreen {
    align: center middle;
}

#login-shell {
    width: 100%;
    height: 1fr;
    align: center middle;
}

#login-card {
    width: 62;
    max-width: 96%;
    height: auto;
    padding: 1 3;
    background: $surface;
    border: round $primary;
}

#login-card.compact {
    padding: 0 3;
}

#login-card.compact #login-actions {
    margin-top: 1;
}

#login-card.compact #login-status {
    height: 1;
}

#brand {
    width: 100%;
    height: auto;
    align-horizontal: center;
    margin-bottom: 1;
}

#login-logo {
    height: 9;
    width: auto;
    margin-bottom: 1;
}

#login-logo-art {
    height: 9;
    width: auto;
    text-align: center;
    margin-bottom: 1;
}

#logo {
    width: auto;
    text-align: center;
}

#wordmark {
    width: auto;
    text-align: center;
}

#tagline {
    width: 100%;
    text-align: center;
    color: $text-muted;
    margin-bottom: 2;
}

.field-label {
    margin-top: 1;
    color: $text-muted;
    text-style: bold;
}

#login-card Input {
    background: $background;
    border: tall $panel;
}

#login-card Input:focus {
    border: tall $primary;
}

#login-actions {
    height: auto;
    align-horizontal: right;
    margin-top: 2;
}

#connect {
    min-width: 16;
}

#login-status {
    height: 2;
    margin-top: 1;
    color: $text-muted;
}

/* ---------------------------------------------------------------- main */

#body {
    height: 1fr;
}

#sidebar {
    width: 26;
    background: $surface;
    border-right: solid $panel;
    padding-top: 1;
}

.section-title {
    padding: 0 1;
    color: $text-muted;
    text-style: bold;
}

#libraries {
    height: 1fr;
    background: transparent;
    border: none;
    padding: 0;
}

#libraries > .option-list--option {
    padding: 0 1;
}

#libraries > .option-list--option-highlighted {
    background: $primary 38%;
    color: $foreground;
    text-style: bold;
}

#main {
    width: 1fr;
}

#breadcrumb {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $foreground;
}

#search {
    display: none;
    height: 3;
    margin: 0 1;
    background: $background;
    border: tall $panel;
}

#search:focus {
    border: tall $primary;
}

#items {
    height: 1fr;
}

DataTable > .datatable--header {
    background: $panel;
    color: $primary;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $primary 38%;
    color: $foreground;
}

DataTable > .datatable--even-row {
    background: $background;
}

DataTable > .datatable--odd-row {
    background: $surface;
}

#details {
    width: 42;
    background: $surface;
    border-left: solid $panel;
    padding: 0 1;
}

#poster-box {
    display: none;
    height: 12;
    width: 100%;
    margin: 1 0;
    align-horizontal: center;
}

#poster {
    height: auto;
    width: auto;
}

#poster-art {
    height: 12;
    width: auto;
    text-align: center;
}

#details-scroll {
    height: 1fr;
}

#details-title {
    padding-top: 1;
    color: $foreground;
    text-style: bold;
}

#details-meta {
    color: $text-muted;
}

#details-body {
    margin-top: 1;
    color: $foreground;
}

/* ---------------------------------------------------------- now playing */

#nowplaying {
    height: 3;
    background: $panel;
    border-top: solid $panel;
    padding: 0 1;
    align-vertical: middle;
}

#now-title {
    width: 2fr;
    content-align-vertical: middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
    color: $foreground;
}

#now-progress {
    width: 3fr;
    margin: 0 1;
}

#now-meta {
    width: auto;
    min-width: 20;
    content-align-vertical: middle;
    text-align: right;
    color: $text-muted;
}

/* --------------------------------------------------------------- modals */

ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

#dialog {
    width: 64;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

#dialog.compact-dialog {
    width: 60;
}

#dialog.track-dialog {
    width: 76;
}

#dialog.help-dialog {
    width: 76;
    height: 84%;
}

#dialog-title {
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}

.dialog-subject {
    color: $foreground;
    text-style: bold;
}

.dialog-body {
    color: $foreground;
}

.dialog-hint {
    color: $text-muted;
    margin-top: 1;
}

.dialog-buttons {
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

.dialog-buttons Button {
    margin-left: 1;
}

#track-options {
    height: auto;
    max-height: 18;
    background: $background;
    border: none;
}

#track-options > .option-list--option-highlighted {
    background: $primary 38%;
    color: $foreground;
}

/* ------------------------------------------------------------- music player */

MusicPlayerScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.8);
}

#music-panel {
    width: 92%;
    height: 88%;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

#music-kicker {
    height: 1;
    color: $text-muted;
    text-style: bold;
}

#music-body {
    height: 1fr;
}

#music-art-box {
    width: 44;
    height: 18;
    align-horizontal: center;
    align-vertical: middle;
    margin-right: 2;
}

#music-art-image {
    height: 18;
    width: auto;
}

#music-art {
    height: 18;
    width: auto;
    text-align: center;
}

#music-info {
    width: 1fr;
    padding: 0 1;
    align-vertical: middle;
}

#music-title {
    height: auto;
    color: $foreground;
    text-style: bold;
}

#music-subtitle {
    height: auto;
    color: $text-muted;
}

#music-state {
    height: 1;
    margin-top: 1;
    text-style: bold;
}

#music-progress {
    margin: 1 0;
}

#music-time {
    height: 1;
    color: $text-muted;
}

#music-controls {
    height: auto;
    margin-top: 2;
    color: $text-muted;
}

#music-queue-box {
    height: 9;
    border-top: solid $panel;
    padding-top: 1;
}

#music-queue-title {
    height: 1;
    color: $text-muted;
    text-style: bold;
}

#music-queue {
    height: 1fr;
    background: transparent;
    border: none;
    padding: 0;
}

#music-queue > .option-list--option-highlighted {
    background: $primary 38%;
    color: $foreground;
}

#track-panel {
    display: none;
    height: 10;
    border-top: solid $panel;
    padding-top: 1;
}

#track-kicker {
    height: 1;
    color: $text-muted;
    text-style: bold;
}

#track-title {
    height: 1;
    color: $foreground;
    text-style: bold;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#track-subtitle {
    height: 1;
    color: $text-muted;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#track-progress {
    margin: 1 0;
}

#track-time {
    height: 1;
    color: $text-muted;
}

#music-details {
    height: auto;
    margin-top: 1;
    color: $text-muted;
}

/* ------------------------------------------------------------- metadata */

#metadata-panel {
    width: 80;
    max-width: 96%;
    height: 88%;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

#metadata-scroll {
    height: 1fr;
}

#metadata-scroll Input {
    background: $background;
    border: tall $panel;
}

#metadata-scroll Input:focus {
    border: tall $primary;
}

#metadata-scroll TextArea {
    height: 6;
    margin-bottom: 1;
}

.metadata-row {
    height: auto;
}

.metadata-row > Vertical {
    width: 1fr;
    height: auto;
    padding-right: 1;
}

.metadata-section {
    height: 1;
    margin-top: 2;
    color: $primary;
    text-style: bold;
}

#metadata-status {
    height: 2;
    margin-top: 1;
    color: $text-muted;
}

/* -------------------------------------------------------------- metadata lookup */

#metadata-lookup {
    height: auto;
    margin-top: 1;
}

#metadata-lookup Button {
    margin-right: 1;
    min-width: 18;
}

#lookup-panel {
    width: 82;
    max-width: 96%;
    height: 88%;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

.lookup-hint {
    height: auto;
    color: $text-muted;
    margin: 1 0;
}

.lookup-search-row {
    height: auto;
}

.lookup-search-row > Vertical {
    width: 1fr;
    height: auto;
    padding-right: 1;
}

.lookup-search-row > .lookup-year {
    width: 12;
}

.lookup-actions {
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

.lookup-actions Button {
    margin-left: 1;
}

.lookup-actions Checkbox {
    width: auto;
    margin-left: 2;
}

#lookup-status {
    height: 2;
    margin-top: 1;
    color: $text-muted;
}

#lookup-results {
    height: 1fr;
    background: $background;
    border: solid $panel;
    margin-top: 1;
}

#lookup-results > .option-list--option-highlighted {
    background: $primary 38%;
    color: $foreground;
}

#lookup-details {
    height: auto;
    max-height: 9;
    margin-top: 1;
    color: $foreground;
}

/* ------------------------------------------------------------- music queue */

#queue-panel,
#genre-panel {
    width: 92;
    max-width: 96%;
    height: 86%;
    padding: 1 2;
    background: $surface;
    border: round $primary;
}

#queue-summary {
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

#queue-list,
#genre-list {
    height: 1fr;
    background: $background;
    border: solid $panel;
}

#queue-list > .option-list--option-highlighted,
#genre-list > .option-list--option-highlighted {
    background: $primary 38%;
    color: $foreground;
}

#queue-status,
#genre-status {
    height: 2;
    margin-top: 1;
    color: $foreground;
}

#queue-hint,
#genre-hint {
    height: auto;
    color: $text-muted;
}
